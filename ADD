### 3-4. anti_sybil/behavior_simulator.py — 인간 행동 시뮬레이션

```python
"""
인간 행동 시뮬레이터
- 랜덤 딜레이
- 마우스 움직임 시뮬레이션
- 타이핑 속도 시뮬레이션
- 행동 패턴 다양화
"""
import asyncio
import random
import logging
from playwright.async_api import Page

logger = logging.getLogger(__name__)

class BehaviorSimulator:

    async def random_delay(
        self,
        min_sec: float = 1.0,
        max_sec: float = 5.0
    ):
        """랜덤 딜레이 (인간 행동 모방)"""
        delay = random.uniform(min_sec, max_sec)
        # 정규분포로 더 자연스럽게
        delay = max(min_sec, min(max_sec,
            random.gauss((min_sec + max_sec) / 2,
                         (max_sec - min_sec) / 4)
        ))
        logger.debug(f"⏳ 딜레이: {delay:.1f}초")
        await asyncio.sleep(delay)

    async def human_mouse_move(self, page: Page, x: int, y: int):
        """인간적인 마우스 이동 (베지어 곡선)"""
        current = await page.evaluate(
            "() => ({x: window.mouseX || 0, y: window.mouseY || 0})"
        )
        
        # 베지어 곡선 경유점 생성
        steps = random.randint(10, 20)
        ctrl_x = random.randint(
            min(current['x'], x),
            max(current['x'], x)
        )
        ctrl_y = random.randint(
            min(current['y'], y),
            max(current['y'], y)
        )
        
        for i in range(steps + 1):
            t = i / steps
            # 2차 베지어 곡선
            bx = int(
                (1-t)**2 * current['x'] +
                2*(1-t)*t * ctrl_x +
                t**2 * x
            )
            by = int(
                (1-t)**2 * current['y'] +
                2*(1-t)*t * ctrl_y +
                t**2 * y
            )
            await page.mouse.move(bx, by)
            await asyncio.sleep(random.uniform(0.01, 0.05))

    async def human_type(self, page: Page, selector: str, text: str):
        """인간적인 타이핑 속도"""
        await page.click(selector)
        for char in text:
            await page.keyboard.type(char)
            # 타이핑 속도 랜덤 (50~200ms)
            await asyncio.sleep(random.uniform(0.05, 0.2))
            # 가끔 긴 멈춤 (생각하는 척)
            if random.random() < 0.05:
                await asyncio.sleep(random.uniform(0.5, 1.5))

    async def random_scroll(self, page: Page):
        """랜덤 스크롤 (페이지 읽는 척)"""
        scroll_amount = random.randint(100, 500)
        direction     = random.choice([1, -1])
        
        await page.evaluate(
            f"window.scrollBy(0, {scroll_amount * direction})"
        )
        await self.random_delay(0.5, 2.0)

    async def simulate_reading(self, page: Page):
        """페이지 읽기 시뮬레이션"""
        # 랜덤 스크롤 2~5회
        scroll_count = random.randint(2, 5)
        for _ in range(scroll_count):
            await self.random_scroll(page)
            await self.random_delay(1.0, 4.0)

    def get_random_tx_amount(
        self,
        base_amount: float,
        variance_pct: float = 0.3
    ) -> float:
        """랜덤 TX 금액 생성 (패턴 방지)"""
        variance = base_amount * variance_pct
        amount   = random.uniform(
            base_amount - variance,
            base_amount + variance
        )
        # 소수점 불규칙하게
        decimals = random.randint(2, 6)
        return round(amount, decimals)

    def get_random_time_offset(self, base_hour: int) -> int:
        """기준 시간에서 랜덤 오프셋 (분)"""
        return base_hour * 60 + random.randint(-30, 30)
