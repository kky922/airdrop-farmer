### 3-3. anti_sybil/proxy_manager.py — 프록시 로테이션

```python
"""
레지덴셜 프록시 로테이션 관리자
- 지갑별 고정 프록시 매핑
- 자동 로테이션
- 프록시 헬스체크
"""
import asyncio
import aiohttp
import random
import logging
from typing import Optional

logger = logging.getLogger(__name__)

class ProxyManager:
    def __init__(self, config):
        self.config  = config
        self.proxies = config.get('proxies', [])
        self.wallet_proxy_map = {}   # 지갑 → 프록시 고정 매핑
        self._current_index  = 0
        self._health_cache   = {}

    async def get_proxy_for_wallet(self, wallet_address: str) -> dict:
        """지갑별 고정 프록시 반환 (항상 동일 지갑 = 동일 프록시)"""
        if wallet_address not in self.wallet_proxy_map:
            # 새 지갑 → 새 프록시 할당
            proxy = await self._get_healthy_proxy()
            self.wallet_proxy_map[wallet_address] = proxy
            logger.info(f"지갑 {wallet_address[:8]}... → 프록시 {proxy['host']} 매핑")
        
        return self.wallet_proxy_map[wallet_address]

    async def get_next_proxy(self) -> dict:
        """다음 사용 가능한 프록시 반환"""
        return await self._get_healthy_proxy()

    async def _get_healthy_proxy(self) -> dict:
        """헬스체크 통과한 프록시 반환"""
        random.shuffle(self.proxies)
        
        for proxy in self.proxies:
            if await self._health_check(proxy):
                return proxy
        
        raise Exception("사용 가능한 프록시 없음!")

    async def _health_check(self, proxy: dict) -> bool:
        """프록시 헬스체크"""
        cache_key = f"{proxy['host']}:{proxy['port']}"
        
        # 캐시 확인 (5분)
        if cache_key in self._health_cache:
            cached_time, cached_result = self._health_cache[cache_key]
            if (asyncio.get_event_loop().time() - cached_time) < 300:
                return cached_result

        try:
            proxy_url = (
                f"http://{proxy['username']}:{proxy['password']}"
                f"@{proxy['host']}:{proxy['port']}"
            )
            async with aiohttp.ClientSession() as session:
                async with session.get(
                    'https://api.ipify.org?format=json',
                    proxy=proxy_url,
                    timeout=aiohttp.ClientTimeout(total=10)
                ) as resp:
                    if resp.status == 200:
                        data = await resp.json()
                        logger.debug(f"프록시 {proxy['host']} → IP: {data['ip']}")
                        self._health_cache[cache_key] = (
                            asyncio.get_event_loop().time(), True
                        )
                        return True
        except Exception as e:
            logger.warning(f"프록시 {proxy['host']} 헬스체크 실패: {e}")
            self._health_cache[cache_key] = (
                asyncio.get_event_loop().time(), False
            )
        
        return False

    def format_proxy_url(self, proxy: dict) -> str:
        """프록시 URL 포맷"""
        return (
            f"http://{proxy['username']}:{proxy['password']}"
            f"@{proxy['host']}:{proxy['port']}"
        )
