### 3-2. core/scheduler.py — 스케줄러

```python
"""
APScheduler 기반 작업 스케줄러
- 일별 파밍 작업
- 주별 프로젝트 스캔
- 가스비 최적 시간대 자동 선택
"""
import asyncio
import random
from datetime import datetime
from apscheduler.schedulers.asyncio import AsyncIOScheduler
from apscheduler.triggers.cron import CronTrigger
from apscheduler.triggers.interval import IntervalTrigger
import logging

logger = logging.getLogger(__name__)

class BotScheduler:
    def __init__(self, config, notifier):
        self.config   = config
        self.notifier = notifier
        self.scheduler = AsyncIOScheduler(timezone="Asia/Seoul")
        self._setup_jobs()

    def _setup_jobs(self):
        """모든 스케줄 작업 등록"""

        # ── 일별 파밍 작업 (오전 2~4시 랜덤 — 저가스 시간대)
        self.scheduler.add_job(
            self.run_daily_farming,
            CronTrigger(
                hour='2-4',
                minute=str(random.randint(0, 59))
            ),
            id='daily_farming',
            name='일별 에어드랍 파밍',
            misfire_grace_time=3600
        )

        # ── 주별 프로젝트 전면 체크 (매주 월요일 오전 9시)
        self.scheduler.add_job(
            self.run_weekly_scan,
            CronTrigger(
                day_of_week='mon',
                hour=9,
                minute=0
            ),
            id='weekly_scan',
            name='주별 프로젝트 전면 스캔'
        )

        # ── 6시간마다 가스비 모니터링
        self.scheduler.add_job(
            self.monitor_gas_prices,
            IntervalTrigger(hours=6),
            id='gas_monitor',
            name='가스비 모니터링'
        )

        # ── 1시간마다 클레임 체크
        self.scheduler.add_job(
            self.check_pending_claims,
            IntervalTrigger(hours=1),
            id='claim_checker',
            name='클레임 체크'
        )

        logger.info("✅ 모든 스케줄 작업 등록 완료")

    async def start(self):
        self.scheduler.start()
        logger.info("🚀 스케줄러 시작!")
        await self.notifier.send("📅 스케줄러가 시작되었습니다.")
        
        # 무한 대기
        try:
            while True:
                await asyncio.sleep(60)
        except (KeyboardInterrupt, SystemExit):
            self.scheduler.shutdown()
            logger.info("봇 종료")

    async def run_daily_farming(self):
        """일별 파밍 실행"""
        logger.info("🌾 일별 파밍 시작")
        await self.notifier.send("🌾 오늘의 에어드랍 파밍을 시작합니다!")
        
        from projects import get_active_projects
        from web3.wallet_manager import WalletManager
        from anti_sybil.proxy_manager import ProxyManager
        from anti_sybil.behavior_simulator import BehaviorSimulator

        wallet_mgr  = WalletManager(self.config)
        proxy_mgr   = ProxyManager(self.config)
        behavior    = BehaviorSimulator()

        active_projects = get_active_projects(self.config)
        results = []

        for project in active_projects:
            try:
                # 프록시 로테이션
                proxy = await proxy_mgr.get_next_proxy()
                
                # 인간 행동 딜레이
                await behavior.random_delay(min_sec=300, max_sec=1800)
                
                # 파밍 실행
                result = await project.farm(
                    wallet_mgr=wallet_mgr,
                    proxy=proxy,
                    behavior=behavior
                )
                results.append(result)
                logger.info(f"✅ {project.name} 파밍 완료: {result}")

            except Exception as e:
                logger.error(f"❌ {project.name} 파밍 실패: {e}")
                await self.notifier.send(f"⚠️ {project.name} 파밍 실패: {e}")

        # 결과 리포트
        report = self._generate_daily_report(results)
        await self.notifier.send(report)

    async def run_weekly_scan(self):
        """주별 프로젝트 전면 스캔"""
        logger.info("🔍 주별 프로젝트 스캔 시작")
        await self.notifier.send("🔍 주간 프로젝트 전면 스캔을 시작합니다!")

        from scanner.project_scanner import ProjectScanner
        scanner = ProjectScanner(self.config)

        # 기존 프로젝트 상태 체크
        existing_report = await scanner.check_existing_projects()
        
        # 신규 프로젝트 탐색
        new_projects = await scanner.discover_new_projects()
        
        # 점수화 및 추천
        scored = await scanner.score_and_recommend(new_projects)

        report = self._generate_weekly_report(existing_report, scored)
        await self.notifier.send(report)

    async def monitor_gas_prices(self):
        """가스비 모니터링"""
        from web3.gas_optimizer import GasOptimizer
        optimizer = GasOptimizer(self.config)
        gas_info  = await optimizer.get_current_gas()
        
        if gas_info['is_low']:
            await self.notifier.send(
                f"⛽ 가스비 낮음 감지!\n"
                f"현재: {gas_info['gwei']} Gwei\n"
                f"지금 TX 실행 권장!"
            )

    async def check_pending_claims(self):
        """미클레임 에어드랍 체크"""
        from web3.wallet_manager import WalletManager
        wallet_mgr = WalletManager(self.config)
        claims     = await wallet_mgr.check_all_claims()
        
        if claims:
            claim_list = "\n".join([f"• {c}" for c in claims])
            await self.notifier.send(
                f"🎁 클레임 가능한 에어드랍 발견!\n{claim_list}"
            )

    def _generate_daily_report(self, results: list) -> str:
        success = sum(1 for r in results if r.get('success'))
        failed  = len(results) - success
        return (
            f"📊 일별 파밍 리포트\n"
            f"{'─'*30}\n"
            f"✅ 성공: {success}개\n"
            f"❌ 실패: {failed}개\n"
            f"📅 시간: {datetime.now().strftime('%Y-%m-%d %H:%M')}"
        )

    def _generate_weekly_report(self, existing, new_projects) -> str:
        return (
            f"📊 주간 프로젝트 스캔 리포트\n"
            f"{'─'*30}\n"
            f"🔄 기존 프로젝트 체크: {len(existing)}개\n"
            f"🆕 신규 발견 프로젝트: {len(new_projects)}개\n"
            f"⭐ 추천 신규 프로젝트:\n"
            + "\n".join([
                f"  • {p['name']} (점수: {p['score']:.1f})"
                for p in new_projects[:5]
            ])
        )
