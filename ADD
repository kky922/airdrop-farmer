import os
import logging
from web3 import Web3
from eth_account import Account
from eth_account.hdaccount import generate_mnemonic
from typing import List, Dict

logger = logging.getLogger(__name__)

Account.enable_unaudited_hdwallet_features()

class WalletManager:
    def __init__(self, config):
        self.config  = config
        self.wallets = self._load_wallets()

    def _load_wallets(self) -> List[Dict]:
        """환경변수에서 지갑 로드"""
        wallets = []
        
        # 방법 1: 개별 프라이빗 키
        i = 1
        while True:
            key = os.getenv(f'WALLET_{i}_PRIVATE_KEY')
            if not key:
                break
            account = Account.from_key(key)
            wallets.append({
                'index':       i,
                'address':     account.address,
                'private_key': key,
                'account':     account,
            })
            i += 1
        
        # 방법 2: 니모닉 + 경로
        mnemonic = os.getenv('WALLET_MNEMONIC')
        if mnemonic:
            count = int(os.getenv('WALLET_COUNT', '5'))
            for idx in range(count):
                path    = f"m/44'/60'/0'/0/{idx}"
                account = Account.from_mnemonic(mnemonic, account_path=path)
                wallets.append({
                    'index':       idx + 1,
                    'address':     account.address,
                    'private_key': account.key.hex(),
                    'account':     account,
                })
        
        logger.info(f"✅ {len(wallets)}개 지갑 로드 완료")
        return wallets

    def get_wallet(self, index: int) -> Dict:
        """인덱스로 지갑 조회"""
        return self.wallets[index % len(self.wallets)]

    def get_all_wallets(self) -> List[Dict]:
        return self.wallets

    async def get_balance(
        self,
        wallet_address: str,
        chain_rpc: str
    ) -> float:
        """ETH 잔액 조회"""
        w3      = Web3(Web3.HTTPProvider(chain_rpc))
        balance = w3.eth.get_balance(wallet_address)
        return w3.from_wei(balance, 'ether')

    async def check_all_claims(self) -> List[str]:
        """모든 지갑의 클레임 가능 에어드랍 체크"""
        claims = []
        # Cursor에게 위임: 각 프로젝트별 클레임 체크 로직 구현
        # 예: Monad, Taiko, Linea 등 클레임 컨트랙트 호출
        return claims

    def sign_transaction(
        self,
        wallet_index: int,
        tx: dict
    ) -> str:
        """트랜잭션 서명"""
        wallet = self.get_wallet(wallet_index)
        signed = wallet['account'].sign_transaction(tx)
        return signed.rawTransaction.hex()
